# ---- Build directories ------------------------------------------------------
# CMake configure + build trees. The default `build/` plus any tagged
# variants (build-release/, build-debug/, build-clang/, ...).
build/
build-*/

# FetchContent populated sources (Lua, sol2, toml++, stb, ImGui, GLFW, Vulkan
# headers). Cached in the build tree under _deps/, but a stray top-level _deps/
# from a misconfigured superproject should never land in version control.
_deps/

# ---- CMake and compiler artifacts -----------------------------------------
CMakeCache.txt
CMakeFiles/
cmake_install.cmake
install_manifest.txt
compile_commands.json
.cache/

# Makefile generated by CMake's default generator (kept out of the tree so a
# stale one never shadows a regenerated build).
Makefile

# Object files, static archives, shared libraries, executables.
*.o
*.obj
*.a
*.so
*.so.*
*.dylib
*.dll
*.exe

# ---- Engine runtime outputs -----------------------------------------------
# CMake assembles runtime/ from build outputs (the executable, config/, mods/,
# shaders/*.spv, modules/*.so). Everything under it is derived.
runtime/

# Compiled SPIR-V shaders (build output, never authored by hand).
*.spv

# The screenshot module writes captures here by default.
screenshots/

# ---- IDE, editor and OS noise ---------------------------------------------
.vscode/
.idea/
.vs/
*.user
*.suo
*.vcxproj*
CMakeSettings.json

# Vim swap files and Emacs backup/lock files.
*.swp
*.swo
*~
\#*\#
.\#*

# macOS Finder metadata and Linux trash.
.DS_Store
Thumbs.db
#version 450
#extension GL_GOOGLE_include_directive : require
// Radiance cascades, compose stage (the world_space_radiance_cascades
// placement capability; see modules/radiance_cascades/README.md).
//
// Front-to-back composition of the interval partitioning, coarsest cascade
// first, identical to the screen-space path:
//
//   full[C-1] = march[C-1].radiance + march[C-1].transmittance * sky
//   full[c]   = march[c].radiance   + march[c].transmittance * sample(full[c+1])
//
// The sky base uses the GRADIENT sky only (no sun disk - same rationale as
// screen-space: a sub-pixel disk aliases into the coarse angular texels).
//
// The spatial part of the composition samples the coarser probe grid at the
// parent probe's world position - the world-space grid origin shifts by
// half the coarser cell size per cascade (cell size doubles), so the
// bilinear sample is computed in world space (vec3 cell -> coarse cell
// -> bilinear). The angular part is the IDENTITY (the angular schedule is
// constant across cascades, same as screen-space).


#include "scene_common.glsl"
#include "environment_common.glsl"
#include "common/cascade_common.glsl"

layout(set = 1, binding = 0) uniform sampler2DArray fullCoarseSampler;
layout(set = 1, binding = 1, rgba16f) uniform restrict writeonly image2DArray fullFine;
layout(set = 1, binding = 2, rgba16f) uniform restrict readonly image2DArray marchFine;

layout(local_size_x = 4, local_size_y = 4, local_size_z = 8) in;

layout(push_constant) uniform ComposePush
{
    layout(offset = 0) vec4 coarsestFlag;   // w 1 when this is the coarsest cascade (sky base)
    layout(offset = 16) uvec4 fineGrid;     // x gridW, y gridH, z directionCount, w gridD (cascade being written)
    layout(offset = 32) uvec4 coarseGrid;   // x gridW, y gridH, z directionCount, w gridD (cascade c+1)
    layout(offset = 48) vec4 fineOriginCellSize;  // xyz fine grid origin (world), w fine cell size
    layout(offset = 64) vec4 coarseOriginCellSize; // xyz coarse grid origin (world), w coarse cell size
} push_;

void main()
{
    const uvec3 cell = uvec3(gl_GlobalInvocationID.x,
                             gl_GlobalInvocationID.y % push_.fineGrid.y,
                             gl_GlobalInvocationID.y / push_.fineGrid.y);
    const uint directionIndex = gl_GlobalInvocationID.z;
    if (cell.x >= push_.fineGrid.x || cell.y >= push_.fineGrid.y
        || cell.z >= push_.fineGrid.w || directionIndex >= push_.fineGrid.z)
    {
        return;
    }

    const ivec2 fineCoord = ivec2(int(cell.x), int(cell.y) + int(cell.z) * int(push_.fineGrid.y));
    const vec4 marched = imageLoad(marchFine, ivec3(fineCoord, int(directionIndex)));
    const vec3 radiance = marched.rgb;
    const float transmittance = marched.a;

    vec3 farRadiance = vec3(0.0);
    if (push_.coarsestFlag.w > 0.5)
    {
        // The last cascade interval ends in open space: escaped rays see
        // the sky. Gradient sky WITHOUT the sun disk (the transport field
        // must stay smooth - see the screen-space rc_compose.comp header).
        farRadiance = skyBase(cascadeDirections[directionIndex].xyz);
    }
    else
    {
        // Find this probe's world position, then sample the coarse grid at
        // that position. The coarse grid has 2x cell size and 2x-stride
        // cells, so the bilinear sample picks the four coarse probes whose
        // cells straddle this probe's world position.
        const vec3 finePosition = push_.fineOriginCellSize.xyz
                                + (vec3(cell) + vec3(0.5)) * push_.fineOriginCellSize.w;
        const vec3 coarseCell = (finePosition - push_.coarseOriginCellSize.xyz)
                              / push_.coarseOriginCellSize.w;
        const vec3 base = floor(coarseCell - vec3(0.5));
        const vec3 fraction = clamp(coarseCell - vec3(0.5) - base, vec3(0.0), vec3(1.0));

        const ivec3 gridLimit = ivec3(push_.coarseGrid.xyz) - ivec3(1);
        // Clamp to the coarse grid's extent: probes outside the grid are
        // treated as the nearest in-grid probe (a clamp, not a wrap). Cells
        // outside the coarse grid would sample undefined texels.
        const ivec3 c000 = ivec3(clamp(ivec3(base), ivec3(0), gridLimit));
        const ivec3 c100 = ivec3(clamp(c000 + ivec3(1, 0, 0), ivec3(0), gridLimit));
        const ivec3 c010 = ivec3(clamp(c000 + ivec3(0, 1, 0), ivec3(0), gridLimit));
        const ivec3 c110 = ivec3(clamp(c000 + ivec3(1, 1, 0), ivec3(0), gridLimit));
        const ivec3 c001 = ivec3(clamp(c000 + ivec3(0, 0, 1), ivec3(0), gridLimit));
        const ivec3 c101 = ivec3(clamp(c000 + ivec3(1, 0, 1), ivec3(0), gridLimit));
        const ivec3 c011 = ivec3(clamp(c000 + ivec3(0, 1, 1), ivec3(0), gridLimit));
        const ivec3 c111 = ivec3(clamp(c000 + ivec3(1, 1, 1), ivec3(0), gridLimit));

        const int coarseLayer = int(directionIndex); // constant angular schedule
        // Normalize the per-cell texel-space coordinates (cell_x, cell_y +
        // cell_z * gridH) to the 2D array image's UV space [0,1]: the image
        // extent is (gridW, gridH * gridD). texture() requires normalized
        // UVs (texelFetch would use integer texel coords, but the bilinear
        // blend across the 8 coarse-grid neighbors needs the sampler's
        // filtering, which is UV-space).
        const float invCoarseW = 1.0 / float(push_.coarseGrid.x);
        const float invCoarseHxD = 1.0 / (float(push_.coarseGrid.y) * float(push_.coarseGrid.w));
        const vec2 coarseTx000 = (vec2(float(c000.x), float(c000.y) + float(c000.z) * float(push_.coarseGrid.y)) + vec2(0.5))
                                  * vec2(invCoarseW, invCoarseHxD);
        const vec2 coarseTx100 = (vec2(float(c100.x), float(c100.y) + float(c100.z) * float(push_.coarseGrid.y)) + vec2(0.5))
                                  * vec2(invCoarseW, invCoarseHxD);
        const vec2 coarseTx010 = (vec2(float(c010.x), float(c010.y) + float(c010.z) * float(push_.coarseGrid.y)) + vec2(0.5))
                                  * vec2(invCoarseW, invCoarseHxD);
        const vec2 coarseTx110 = (vec2(float(c110.x), float(c110.y) + float(c110.z) * float(push_.coarseGrid.y)) + vec2(0.5))
                                  * vec2(invCoarseW, invCoarseHxD);
        const vec2 coarseTx001 = (vec2(float(c001.x), float(c001.y) + float(c001.z) * float(push_.coarseGrid.y)) + vec2(0.5))
                                  * vec2(invCoarseW, invCoarseHxD);
        const vec2 coarseTx101 = (vec2(float(c101.x), float(c101.y) + float(c101.z) * float(push_.coarseGrid.y)) + vec2(0.5))
                                  * vec2(invCoarseW, invCoarseHxD);
        const vec2 coarseTx011 = (vec2(float(c011.x), float(c011.y) + float(c011.z) * float(push_.coarseGrid.y)) + vec2(0.5))
                                  * vec2(invCoarseW, invCoarseHxD);
        const vec2 coarseTx111 = (vec2(float(c111.x), float(c111.y) + float(c111.z) * float(push_.coarseGrid.y)) + vec2(0.5))
                                  * vec2(invCoarseW, invCoarseHxD);

        const vec3 s000 = texture(fullCoarseSampler, vec3(coarseTx000, float(coarseLayer))).rgb;
        const vec3 s100 = texture(fullCoarseSampler, vec3(coarseTx100, float(coarseLayer))).rgb;
        const vec3 s010 = texture(fullCoarseSampler, vec3(coarseTx010, float(coarseLayer))).rgb;
        const vec3 s110 = texture(fullCoarseSampler, vec3(coarseTx110, float(coarseLayer))).rgb;
        const vec3 s001 = texture(fullCoarseSampler, vec3(coarseTx001, float(coarseLayer))).rgb;
        const vec3 s101 = texture(fullCoarseSampler, vec3(coarseTx101, float(coarseLayer))).rgb;
        const vec3 s011 = texture(fullCoarseSampler, vec3(coarseTx011, float(coarseLayer))).rgb;
        const vec3 s111 = texture(fullCoarseSampler, vec3(coarseTx111, float(coarseLayer))).rgb;

        // Trilinear weights.
        const float fx = fraction.x;
        const float fy = fraction.y;
        const float fz = fraction.z;
        const vec3 s00 = mix(s000, s100, fx);
        const vec3 s01 = mix(s001, s101, fx);
        const vec3 s10 = mix(s010, s110, fx);
        const vec3 s11 = mix(s011, s111, fx);
        const vec3 s0 = mix(s00, s01, fz);
        const vec3 s1 = mix(s10, s11, fz);
        farRadiance = mix(s0, s1, fy);
    }

    const vec3 composed = radiance + transmittance * farRadiance;
    imageStore(fullFine, ivec3(fineCoord, int(directionIndex)), vec4(composed, 1.0));
}

#version 450
#extension GL_GOOGLE_include_directive : require
// Radiance cascades, march stage (the world_space_radiance_cascades
// placement capability; see modules/radiance_cascades/README.md).
//
// World-space probes live in a dense 3D grid (camera-centered, cell size =
// world_cell_size * 2^cascade). Each probe's anchor is its world-space cell
// center, NOT a depth-buffer pixel - the march traces the analytic scene SDF
// from a position independent of the camera's view direction, so probes can
// sample geometry that is off screen (the whole point of world-space RC).
//
// One invocation per (probe, direction). The probe grid is laid out in a 2D
// array image where texel (x, y, layer) holds the marched (rgb radiance,
// a transmittance) for probe (cell_x=x, cell_y=y % gridH, cell_z=y / gridH)
// and direction = layer. The layer count equals the direction count (the
// same direction table the screen-space path uses), so the image stays
// within Vulkan's maxImageArrayLayers guarantee (>= 256) for direction
// counts up to 256 - the world-space base_rays clamps accordingly at
// rebuild time.
//
// No anchor lane: world-space probes are independent (each probe's anchor is
// its deterministic cell center, not a depth-buffer-derived value that
// neighbouring directions could share). The screen-space anchor lane was an
// amortization across directions of one expensive depth-buffer-derived
// anchor; here the anchor is a 3-float multiply, cheaper than the
// shared-memory round trip.
//
// Multi-bounce: same pattern as screen-space. Bounce b > 0 samples the
// previous bounce's gathered transport at the hit's screen position and
// adds it through the same albedo/pi chain as the direct relight.


#include "relight_common.glsl"
#include "common/cascade_common.glsl"

layout(local_size_x = 4, local_size_y = 4, local_size_z = 8) in;

layout(set = 1, binding = 0) uniform sampler2D depthSampler;       // for bounce > 0 hit reprojection only
layout(set = 1, binding = 1) uniform sampler2D normalSampler;       // unused but kept for layout parity with the screen-space gather descriptor set (the gather reads the normal sampler; this set is shared by the march)
layout(set = 1, binding = 2, rgba16f) uniform restrict writeonly image2DArray cascadeMarch;
layout(set = 1, binding = 3) uniform sampler2D prevGi;              // previous bounce's gathered transport

layout(push_constant) uniform MarchPush
{
    layout(offset = 0) vec4 interval;       // x tStart, y tEnd (world-space depth along the ray, from the probe anchor)
    layout(offset = 16) uvec4 flags;        // x primitiveCount, y maxSteps, z unused (world anchor is deterministic, no camera-anchored flag), w bounce index
    layout(offset = 32) uvec4 grid;         // x gridW, y gridH, z directionCount, w gridD (cells per axis)
    layout(offset = 48) vec4 extentStride;  // xyz gridOrigin (world), w cellSize
    layout(offset = 64) uvec4 anchor;       // unused (kept for byte-layout parity with screen-space rc_march.comp)
} push_;

void main()
{
    const uvec3 cell = uvec3(gl_GlobalInvocationID.x,
                             gl_GlobalInvocationID.y % push_.grid.y,
                             gl_GlobalInvocationID.y / push_.grid.y);
    const uint directionIndex = gl_GlobalInvocationID.z;
    if (cell.x >= push_.grid.x || cell.y >= push_.grid.y || cell.z >= push_.grid.w
        || directionIndex >= push_.grid.z)
    {
        return;
    }

    // The probe's world anchor: deterministic from the cell index. The grid
    // is camera-centered at the rebuild's snapshot of the camera position,
    // so the grid follows the camera between frames but the cell-to-world
    // transform is constant for one frame.
    const vec3 anchor = push_.extentStride.xyz
                      + (vec3(cell) + vec3(0.5)) * push_.extentStride.w;

    const vec3 direction = cascadeDirections[directionIndex].xyz;

    // The march range along the ray is the cascade's world-depth interval
    // [tStart, tEnd]: forward directions march from tStart to tEnd; backward
    // directions (cosine < 0 against the cell-to-camera vector, which for
    // world-space probes is just the negative direction of the ray if it
    // points away from the camera) march only down to tStart - the same
    // "do not cross the camera plane" guard the screen-space path uses,
    // adapted to the world anchor.
    //
    // For world-space, the backward-direction guard is geometrically
    // different: there is no camera plane to bound against. Instead, the
    // march range is symmetric around the probe (forward directions march
    // [0, tEnd - tStart]; backward directions march [tStart - tEnd, 0]). The
    // interval partition is therefore measured along the ray, not the view
    // depth - simpler than screen-space, because the anchor is already at a
    // known world position.
    const float marchStart = 0.0;
    const float marchEnd = max(push_.interval.y - push_.interval.x, 0.001);

    uint hitOwner;
    const float hit = traceIntervalOwned(anchor, direction, marchStart, marchEnd,
                                         push_.flags.x, push_.flags.y, hitOwner);

    vec4 result = vec4(0.0, 0.0, 0.0, 1.0); // unoccluded by default
    if (hit > 0.0)
    {
        const vec3 hitPoint = anchor + direction * hit;
        vec3 normal = sdfNormal(hitPoint, push_.flags.x);
        normal *= -sign(dot(normal, direction));
        vec3 materialAlbedo;
        vec3 radiance = surfaceOutgoingRadianceOwned(hitPoint, normal, hitOwner, push_.flags.x, materialAlbedo);
        // Multi-bounce transport: the previous bounce's gather image carries
        // that bounce's indirect irradiance/pi at every screen pixel; the hit
        // adds it through the same Lambertian albedo/pi chain as the direct
        // term. The transport here is world-space: a hit whose projection
        // lands off screen still has its direct relight (always present),
        // and the previous-bounce sample is gated by the projection's screen
        // validity - off-screen hits degrade to direct-only for the
        // bounce contribution (a documented second-order limit, identical
        // to the screen-space path's bounce sample).
        if (push_.flags.w > 0u)
        {
            const vec4 hitClip = viewProjection * vec4(hitPoint, 1.0);
            if (hitClip.w > 0.0)
            {
                const vec2 hitUv = hitClip.xy / hitClip.w * 0.5 + vec2(0.5);
                if (all(greaterThan(hitUv, vec2(0.0))) && all(lessThan(hitUv, vec2(1.0))))
                {
                    radiance += materialAlbedo * textureLod(prevGi, hitUv, 0.0).rgb;
                }
            }
        }
        result = vec4(radiance, 0.0);
    }

    const int layer = int(directionIndex);
    const ivec2 outCoord = ivec2(int(cell.x), int(cell.y) + int(cell.z) * int(push_.grid.y));
    imageStore(cascadeMarch, ivec3(outCoord, layer), result);
    // World-space probes are deterministic - their world anchor is derived
    // from the cell index, not from a depth-buffer-derived value the
    // gather would otherwise re-derive per pixel per probe corner. There
    // is no probe anchor field binding here (the screen-space path's
    // binding 4 is dropped from the world-space march role set); the
    // gather reads the cell-to-world transform from the gather push
    // constants, recomputing each probe's anchor on demand - cheaper
    // than a per-pixel per-probe imageLoad of a published anchor.
}

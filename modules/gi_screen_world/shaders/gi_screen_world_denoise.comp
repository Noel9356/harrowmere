#version 450
#extension GL_GOOGLE_include_directive : require
// The GI pass's spatial filter: a Gaussian depth/normal bilateral over the
// gather output, guided by the view depth the gather stored in the target's
// alpha channel and by the G-buffer's world normals, with a
// neighborhood-outlier clamp (robust statistics). One ray per pixel leaves
// the estimator variance visible as a per-pixel dot lattice; rev 30's 4-tap
// cross left most of it standing (the owner's "this GI is noisy"). The 3x3
// footprint averages EIGHT neighbours under a Gaussian kernel - the standard
// screen-space companion of a temporal accumulator, the same shape Lumen's
// final-gather filter takes - and the outlier clamp trims the residual
// bright speck before it can enter the blend.
//
// Rev 33 (configurable): the kernel radius rides the push block
// (giPush.params4.x, `filter_radius` in [lighting.gi_screen_world]).
//   radius 0  - the filter is bypassed (the raw estimate passes through;
//               the A/B against the unfiltered estimator)
//   radius 1  - the shipped 3x3 kernel (the rev-30 weights, exact)
//   radius 2-4 - a wider Gaussian support (sigma = 0.6 * radius) for the
//               heavier estimators (rays_per_pixel = 1) at proportionate
//               cost - up to (2r+1)^2 taps per pixel.
// The radius semantics match Lumen's ScreenProbeGather.SpatialFilterNumPasses
// in spirit: the dial that trades blur against estimator noise. Lumen
// filters in PROBE space (its 3x3 probe kernel covers a 48x48 screen
// footprint); a per-pixel gather filters here, in screen space, which is
// exactly the cost Lumen's probe design exists to avoid - documented in
// README.md as a deliberate difference.
//
// Runs after the gather dispatch: samples the gather target, writes the
// filtered image the pass copies back over the target and into its history.

layout(local_size_x = 8, local_size_y = 8, local_size_z = 1) in;

layout(set = 1, binding = 5) uniform sampler2D giInputSampler; // rgb gathered irradiance/pi, a view depth
layout(set = 1, binding = 6, rgba16f) uniform restrict writeonly image2D filteredImage;
layout(set = 1, binding = 1) uniform sampler2D normalSampler; // rgb world normal, a metallic

// The push block the gather dispatch pushed (same pipeline layout, so the
// values persist into this dispatch): only params4.x (the filter radius) is
// read here.
layout(push_constant) uniform GiPush
{
    layout(offset = 0) uvec4 counts;
    layout(offset = 16) vec4 params;
    layout(offset = 32) vec4 params2;
    layout(offset = 48) uvec4 flags;
    layout(offset = 64) vec4 params3;
    layout(offset = 80) vec4 params4;
} giPush;

// The rev-30 radius-1 shape for reference: separable [1 2 1] x [1 2 1],
// corners weigh 1, edges 2, center 4. Radius 2-4 generalize it with an
// isotropic Gaussian (sigma = 0.6 r) over the square support.

void main()
{
    const ivec2 pixel = ivec2(gl_GlobalInvocationID.xy);
    const ivec2 resolution = imageSize(filteredImage);
    if (pixel.x >= resolution.x || pixel.y >= resolution.y)
    {
        return;
    }
    const vec2 uv = (vec2(pixel) + 0.5) / vec2(resolution);
    const vec2 texel = 1.0 / vec2(resolution);

    const vec4 center = texture(giInputSampler, uv);
    // Sky pixels pass through untouched: there is no estimator variance on
    // a constant sky miss, and the 60000 depth sentinel would poison the
    // depth weights of every neighbouring surface tap.
    if (center.a >= 30000.0)
    {
        imageStore(filteredImage, pixel, center);
        return;
    }

    // filter_radius = 0: the A/B passthrough (no filter at all).
    const int radius = int(clamp(giPush.params4.x, 0.0, 4.0));
    if (radius <= 0)
    {
        imageStore(filteredImage, pixel, center);
        return;
    }

    const vec3 centerNormal = normalize(texture(normalSampler, uv).xyz);

    // The depth band scales with the central depth (the temporal confidence's
    // metric); the normal weight is a tight cone - only taps on the same
    // plane belong in the average.
    const float depthBand = max(0.05, 0.06 * center.a);

    // Pass 1 - neighborhood moments: the robust mean of the SAME taps the
    // Gaussian will blend, so the outlier clamp is a statistic of the actual
    // support, not of an arbitrary window. The tap set grows with the
    // radius: radius 1 uses the exact rev-30 8-tap kernel; radius 2-4 use
    // an isotropic Gaussian over the (2r+1)^2 support (sigma = 0.6 r).
    const float sigma2 = 2.0 * pow(0.6 * max(float(radius), 1.0), 2.0);
    const int maxTaps = (2 * 4 + 1) * (2 * 4 + 1) - 1; // 80 taps at the radius-4 cap
    vec3 taps[maxTaps];
    float tapWeights[maxTaps];
    uint usedTaps = 0u;
    vec3 momentSum = vec3(0.0);
    float momentWeight = 0.0;
    for (int dy = -radius; dy <= radius; ++dy)
    {
        for (int dx = -radius; dx <= radius; ++dx)
        {
            if (dx == 0 && dy == 0)
            {
                continue; // the center rides outside the average (below)
            }
            const ivec2 offset = ivec2(dx, dy);
            const vec2 tapUv = uv + vec2(offset) * texel;
            const vec4 tapData = texture(giInputSampler, tapUv);
            if (tapData.a >= 30000.0)
            {
                continue; // sky beside a surface: not part of the average
            }
            const float depthWeight = exp(-abs(tapData.a - center.a) / depthBand);
            const vec3 tapNormal = normalize(texture(normalSampler, tapUv).xyz);
            const float normalWeight = pow(max(dot(tapNormal, centerNormal), 0.0), 32.0);
            // Radius 1: the exact rev-30 weight table (Manhattan distance -
            // corners 1, edges 2). Radius 2-4: an isotropic Gaussian over
            // the square support (sigma = 0.6 r).
            const float spatialWeight = radius == 1
                ? ((abs(dx) + abs(dy) == 2) ? 1.0 : 2.0)
                : exp(-float(dx * dx + dy * dy) / sigma2);
            const float weight = spatialWeight * depthWeight * normalWeight;
            if (weight < 1e-3)
            {
                continue; // a silhouette side: not part of the moments either
            }
            taps[usedTaps] = tapData.rgb;
            tapWeights[usedTaps] = weight;
            momentSum += taps[usedTaps] * weight;
            momentWeight += weight;
            ++usedTaps;
        }
    }

    vec3 result = center.rgb;
    if (usedTaps > 0u && momentWeight > 1e-4)
    {
        const vec3 mean = momentSum / momentWeight;
        // The robust sigma: the mean absolute deviation of the same taps,
        // scaled to a Gaussian-equivalent (MAD * 1.2533). Deviation beyond
        // 2 sigma is estimator outlier, not signal - clamp the tap there so
        // a lone firefly cannot survive the average by sitting next to its
        // own kind.
        vec3 mad = vec3(0.0);
        for (uint t = 0u; t < usedTaps; ++t)
        {
            mad += abs(taps[t] - mean) * (tapWeights[t] / momentWeight);
        }
        const vec3 sigma = mad * 1.2533 * 2.0;
        const vec3 lo = mean - sigma;
        const vec3 hi = mean + sigma;

        // Pass 2 - the Gaussian blend with the clamped taps (the center
        // keeps weight 4 at radius 1, weight 1 in the wider isotropic rule).
        const float centerWeight = radius == 1 ? 4.0 : 1.0;
        vec3 sum = center.rgb * centerWeight;
        float weightSum = centerWeight;
        for (uint t = 0u; t < usedTaps; ++t)
        {
            sum += clamp(taps[t], lo, hi) * tapWeights[t];
            weightSum += tapWeights[t];
        }
        result = sum / weightSum;
    }

    imageStore(filteredImage, pixel, vec4(result, center.a));
}

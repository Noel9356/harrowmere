// Bloom blur (compute): one separable Gaussian pass over the bloom chain.
//
// Dispatched twice per frame - horizontal into the pong image, vertical back
// into the ping image - with the direction carried in the push constant. The
// 9-tap kernel at half resolution approximates a wide, cheap glow; the
// engine's look tuning lives in the [renderer] bloom keys, not here.

#version 450

layout(local_size_x = 8, local_size_y = 8, local_size_z = 1) in;

layout(set = 0, binding = 0) uniform sampler2D sourceSampler;   // rgba16f
layout(set = 0, binding = 1, rgba16f) uniform writeonly image2D destinationImage;

layout(push_constant) uniform BlurPush
{
    layout(offset = 0) vec4 directionTexel; // xy direction (1,0 or 0,1) in texels, z/w unused
} blur;

void main()
{
    ivec2 target = ivec2(gl_GlobalInvocationID.xy);
    ivec2 extent = imageSize(destinationImage);
    if (target.x >= extent.x || target.y >= extent.y)
    {
        return;
    }

    // 9-tap Gaussian, sigma ~ 2 texels. Weights normalized to sum 1.
    const float weights[5] = float[](0.2270270270, 0.1945945946, 0.1216216216, 0.0540540541, 0.0162162162);
    // Direct integer fetches on the tap lattice. The blur chain reads and
    // writes same-extent images and every tap is an integral texel offset
    // from the target texel, so the previous normalized-coordinate path (uv =
    // center/extent, step = direction/extent, uv +/- step*tap) addressed
    // exactly these texels: each fetch spent a divide/bias/multiply chain
    // plus the sampler's filter and wrap machinery to land on an integer
    // coordinate the fetch names directly. The chain sampler is linear +
    // clamp-to-edge; clamping the integer coordinate reproduces the edge
    // behavior exactly (a sample point past the last texel center returns
    // that texel for every clamp mode that holds the border texel, and the
    // integer clamp names the same border texel).
    const ivec2 direction = ivec2(blur.directionTexel.xy); // (1,0) or (0,1)
    const ivec2 lowest    = ivec2(0);
    const ivec2 highest   = extent - ivec2(1);
    vec3 sum = texelFetch(sourceSampler, clamp(target, lowest, highest), 0).rgb * weights[0];
    for (int tap = 1; tap < 5; ++tap)
    {
        sum += texelFetch(sourceSampler, clamp(target + direction * tap, lowest, highest), 0).rgb * weights[tap];
        sum += texelFetch(sourceSampler, clamp(target - direction * tap, lowest, highest), 0).rgb * weights[tap];
    }
    imageStore(destinationImage, target, vec4(sum, 1.0));
}
